# ==== Database ====
POSTGRES_USER=camadmin
POSTGRES_PASSWORD=change_me_db_pass
POSTGRES_DB=camera_platform
DATABASE_URL=postgres://camadmin:change_me_db_pass@postgres:5432/camera_platform

# ==== Backend ====
NODE_ENV=production
PORT=4000
# Secret dùng ký JWT - ĐỔI thành chuỗi ngẫu nhiên dài
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Tài khoản admin khởi tạo lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_pass

# ==== Storage / Streaming ====
# Thư mục host chứa live/recording/snapshot. Linux: /mnt/camera-storage.
# Windows Docker Desktop: C:/Users/<ten-user>/Documents/CameraRTSP/storage
STORAGE_HOST_DIR=./storage
# Nhãn chỉ hiển thị trong trang Storage, không phải đường dẫn container.
STORAGE_LABEL=Camera storage
# Đường dẫn trong container (không cần đổi khi dùng Docker)
STORAGE_ROOT=/storage
# 0 = giữ recording cho đến khi filesystem storage đạt ngưỡng bên dưới.
# Giá trị > 0 sẽ xoá nguyên ngày recording đã quá số giờ này.
RECORD_RETENTION_HOURS=0
# Khi filesystem chứa storage đạt 90%, xoá nguyên ngày recording cũ nhất tới 85%.
# Không xoá live stream, snapshot AI hoặc ngày đang ghi.
STORAGE_CLEANUP_THRESHOLD_PERCENT=90
STORAGE_CLEANUP_TARGET_PERCENT=85
STORAGE_CLEANUP_INTERVAL_MINUTES=10
# Độ dài mỗi segment recording (giây)
RECORD_SEGMENT_SECONDS=600
# HLS live: độ dài segment (giây) và số segment giữ trong playlist
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=6
# Ngày thư mục recording theo múi giờ này. Dùng IANA timezone, ví dụ Asia/Ho_Chi_Minh.
RECORD_TIMEZONE=Asia/Ho_Chi_Minh

# ==== Transcode (dùng cho camera H.265 -> H.264 khi xem live trên web) ====
# preset libx264: ultrafast|superfast|veryfast|faster|fast|medium ...
TRANSCODE_PRESET=veryfast
TRANSCODE_BITRATE=2000k

# ==== AI recognition ====
# Khi bật AI cho camera nhưng không nhập sub-stream, worker đọc HLS live này để thử nghiệm.
# Production nên nhập URL RTSP sub-stream (640p/1-5 FPS) trong từng camera.
AI_HLS_BASE_URL=http://nginx
# Lần chạy đầu Ultralytics tự tải weight vào ./models. Có thể mount weight custom tại đây.
AI_MODEL=/models/yolov8n.pt
# cpu (bản compose mặc định dùng CPU để chạy được cả Mac/Colima và Linux)
AI_DEVICE=cpu
AI_SYNC_SECONDS=15
AI_EVENT_COOLDOWN_SECONDS=20

# ==== Web ====
# URL public để web gọi API (qua nginx). Để trống = same-origin /api
VITE_API_BASE=/api
# Cổng web admin/API trên máy chủ (chỉ mở cho LAN/VPN tin cậy).
HTTP_PORT=8080
